---
import { dialogCopy } from '../../i18n/copy';
import { resolveLocaleFromPathname, type Locale } from '../../i18n/locale';

interface Props {
  locale?: Locale;
}

const {
  locale = resolveLocaleFromPathname(
    Astro.url.pathname,
    import.meta.env.BASE_URL,
  ),
} = Astro.props;
const copy = dialogCopy[locale];
---

<dialog
  class="content-dialog profile-journey-dialog"
  id="profile-journey-dialog"
  aria-labelledby="profile-journey-dialog-title"
>
  <div class="dialog-panel" data-dialog-panel>
    <header class="dialog-header">
      <p class="eyebrow">{copy.profileEyebrow}</p>
      <div class="dialog-header__actions">
        <button
          type="button"
          aria-label={copy.closeProfile}
          data-dialog-close
          autofocus
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m6 6 12 12M18 6 6 18"></path></svg
          >
        </button>
      </div>
    </header>
    <h2 id="profile-journey-dialog-title">{copy.profileTitle}</h2>
    <section class="profile-journey__section" aria-labelledby="journey-heading">
      <h3 id="journey-heading" class="profile-journey__section-title">
        {copy.profileJourneyHeading}
      </h3>
      <dl class="profile-journey__list">
        <div class="profile-journey__item">
          <dt>{copy.profileJourneyEducationLabel}</dt>
          <dd>{copy.profileJourneyEducationText}</dd>
        </div>

        <div class="profile-journey__item">
          <dt>{copy.profileJourneyInternshipLabel}</dt>
          <dd>{copy.profileJourneyInternshipText}</dd>
        </div>

        <div class="profile-journey__item">
          <dt>{copy.profileJourneyHackathonLabel}</dt>
          <dd>{copy.profileJourneyHackathonText}</dd>
        </div>

        <div class="profile-journey__item">
          <dt>{copy.profileJourneyProjectLabel}</dt>
          <dd>{copy.profileJourneyProjectText}</dd>
        </div>
      </dl>
    </section>
  </div>
</dialog>

<style>
  .profile-journey-dialog {
    width: min(580px, calc(100% - 2rem));
  }

  .profile-journey-dialog h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .profile-journey__section-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 1.25rem;
  }

  .profile-journey__list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
  }

  .profile-journey__item {
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .profile-journey__item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .profile-journey__list dt {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text);
    margin-bottom: 0.3rem;
  }

  .profile-journey__list dd {
    margin: 0;
    line-height: 1.55;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
</style>
