---
import { getProfessionalData } from '../../data/localized';
import { links } from '../../data/links';
import { dialogCopy } from '../../i18n/copy';
import { resolveLocaleFromPathname } from '../../i18n/locale';
import { withBase } from '../../utils/paths';

const locale = resolveLocaleFromPathname(
  Astro.url.pathname,
  import.meta.env.BASE_URL,
);
const { profile } = getProfessionalData(locale);
const copy = dialogCopy[locale];
---

<dialog
  class="content-dialog project-dialog"
  id="about-dialog"
  aria-labelledby="about-dialog-title"
>
  <div class="dialog-panel" data-dialog-panel>
    <header class="dialog-header">
      <p class="eyebrow">{copy.aboutEyebrow}</p>
      <div class="dialog-header__actions">
        <a
          href={links.githubProfile}
          target="_blank"
          rel="noopener noreferrer"
          class="dialog-header__icon-link"
          aria-label={copy.viewGitHub}
          title={copy.viewGitHub}
        >
          <svg
            class="icon-brand"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="currentColor"
          >
            <path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path>
          </svg>
        </a>
        {
          links.linkedin && (
            <a
              href={links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="dialog-header__icon-link"
              aria-label={copy.viewLinkedIn}
              title={copy.viewLinkedIn}
            >
              <svg
                class="icon-brand"
                viewBox="0 0 448 512"
                aria-hidden="true"
                fill="currentColor"
              >
                <path d="M100.3 448l-92.9 0 0-299.1 92.9 0 0 299.1zM53.8 108.1C24.1 108.1 0 83.5 0 53.8 0 39.5 5.7 25.9 15.8 15.8s23.8-15.8 38-15.8 27.9 5.7 38 15.8 15.8 23.8 15.8 38c0 29.7-24.1 54.3-53.8 54.3zM447.9 448l-92.7 0 0-145.6c0-34.7-.7-79.2-48.3-79.2-48.3 0-55.7 37.7-55.7 76.7l0 148.1-92.8 0 0-299.1 89.1 0 0 40.8 1.3 0c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3l0 164.3-.1 0z" />
              </svg>
            </a>
          )
        }
        <button
          type="button"
          aria-label={copy.closeAbout}
          data-dialog-close
          autofocus
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m6 6 12 12M18 6 6 18"></path></svg
          >
        </button>
      </div>
    </header>
    <div class="project-dialog__hero">
      <div class="project-dialog__visual project-dialog__visual--photo">
        <img
          src={withBase(profile.aboutImage)}
          alt={profile.aboutImageAlt}
          width="280"
          height="280"
        />
      </div>
      <div>
        <p class="project-dialog__context">{profile.location}</p>
        <h2 id="about-dialog-title">{profile.fullName}</h2>
        <p>{profile.aboutIntro}</p>
      </div>
    </div>
    <div class="about-dialog__details">
      <div>
        <h3>{copy.educationAndProjects}</h3>
        <ul class="about-dialog__milestones">
          {
            profile.milestones.map((milestone) => (
              <li>
                <span>{milestone.label}</span>
                <p>{milestone.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>{copy.seeking}</h3>
        <p>{profile.seeking}</p>
      </div>
    </div>
  </div>
</dialog>
