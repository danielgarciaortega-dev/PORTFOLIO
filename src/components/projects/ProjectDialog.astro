---
import type { Project } from '../../data/types';
import type { Locale } from '../../i18n/locale';
import { projectCopy } from '../../i18n/project-copy';
import { withBase } from '../../utils/paths';

interface Props {
  project: Project;
  nextProject: Project;
  locale: Locale;
}

const { project, nextProject, locale } = Astro.props;
const copy = projectCopy[locale];
---

<dialog
  class="content-dialog project-dialog"
  id={`project-${project.id}`}
  aria-labelledby={`project-${project.id}-title`}
>
  <div class="dialog-panel" data-dialog-panel>
    <header class="dialog-header">
      <p class="eyebrow">{copy.eyebrow}</p>
      <div class="dialog-header__actions">
        {
          project.liveUrl && (
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="dialog-header__icon-link"
              aria-label={copy.openDemoAria(project.title)}
              title={copy.openDemoTitle}
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M14 3h7v7" />
                <path d="M10 14 21 3" />
                <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5" />
              </svg>
            </a>
          )
        }
        {
          project.repositoryUrl && (
            <a
              href={project.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="dialog-header__icon-link"
              aria-label={copy.viewCodeAria(project.title)}
              title={copy.viewCodeTitle}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
              </svg>
            </a>
          )
        }
        {
          project.eventUrl && (
            <a
              href={project.eventUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="dialog-header__icon-link"
              aria-label={copy.viewEventAria(project.title)}
              title={copy.viewEventTitle}
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M14 3h7v7" />
                <path d="M10 14 21 3" />
                <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5" />
              </svg>
            </a>
          )
        }
        <button
          type="button"
          aria-label={copy.closeAria(project.title)}
          data-dialog-close
          autofocus
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m6 6 12 12M18 6 6 18"></path></svg
          >
        </button>
      </div>
    </header>
    <div class="project-dialog__hero">
      <div class="project-dialog__visual">
        {
          project.image && (
            <img
              src={withBase(project.image)}
              alt={project.imageAlt}
              width="280"
              height="280"
            />
          )
        }
      </div>
      <div>
        <p class="project-dialog__context">{project.context}</p>
        <h2 id={`project-${project.id}-title`}>{project.title}</h2>
        {project.award && <p class="award-label">{project.award}</p>}
        <p>{project.modalDescription}</p>
      </div>
    </div>
    <div class="project-dialog__details">
      <div>
        <h3>{copy.objective}</h3>
        <p>{project.objective}</p>
      </div>
      <div>
        <h3>{copy.solution}</h3>
        <p>{project.solution}</p>
      </div>
    </div>
    {
      project.metrics.length > 0 && (
        <ul class="metric-list" aria-label={copy.resultsFor(project.title)}>
          {project.metrics.map((metric) => (
            <li>{metric}</li>
          ))}
        </ul>
      )
    }
    {
      project.role && (
        <div class="project-dialog__role">
          <span>{copy.role}</span>
          <p>{project.role}</p>
        </div>
      )
    }
    <ul class="tag-list" aria-label={copy.technologiesFor(project.title)}>
      {project.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <button
      type="button"
      class="project-dialog__next"
      data-dialog-open={`project-${nextProject.id}`}
    >
      <span class="project-dialog__next-label">{copy.nextProject}</span>
      <span class="project-dialog__next-title">
        {
          nextProject.image && (
            <img
              src={withBase(nextProject.image)}
              alt=""
              width="28"
              height="28"
            />
          )
        }
        {nextProject.title}
      </span>
      <svg viewBox="0 0 20 20" aria-hidden="true"
        ><path d="M4 10h11m-4-4 4 4-4 4"></path></svg
      >
    </button>
  </div>
</dialog>
