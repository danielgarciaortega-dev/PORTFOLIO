---
import { getProfessionalData } from '../../data/localized';
import { links } from '../../data/links';
import { dialogCopy } from '../../i18n/copy';
import { aboutPageCopy } from '../../i18n/about-page-copy';
import {
  getLocalizedRoutePath,
  type Locale,
} from '../../i18n/locale';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
import ButtonLink from '../ui/ButtonLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { profile } = getProfessionalData(locale);
const copy = aboutPageCopy[locale];
const sharedCopy = dialogCopy[locale];

const projectsUrl = withBase(getLocalizedRoutePath(locale, 'projects'));
const cvUrl = withBase(getLocalizedRoutePath(locale, 'cvCenter'));
const contactUrl = `mailto:${links.email}`;
---

<BaseLayout
  title={`${sharedCopy.aboutEyebrow} · ${profile.fullName}`}
  description={profile.aboutIntro}
  currentPage="about"
  localizedRoute="about"
>
  <main id="contenido" class="about-page" data-about-page>
    <section class="about-page__hero" aria-labelledby="about-page-title">
      <figure class="about-page__portrait">
        <img
          src={withBase(profile.aboutImage)}
          alt={profile.aboutImageAlt}
          width="760"
          height="760"
        />
      </figure>

      <div class="about-page__intro">
        <p class="eyebrow">{sharedCopy.aboutEyebrow}</p>
        <p class="about-page__location">{profile.location}</p>
        <h1 id="about-page-title">{profile.fullName}</h1>
        <p class="about-page__role">{profile.role}</p>
        <p class="about-page__lead">{profile.aboutIntro}</p>

        <div class="about-page__focus">
          <p>{copy.currentFocus}</p>
          <span>{profile.heroDescription}</span>
        </div>
      </div>
    </section>

    <section class="about-page__journey" aria-labelledby="about-journey-title">
      <header>
        <p class="eyebrow">{sharedCopy.educationAndProjects}</p>
        <h2 id="about-journey-title">{copy.journey}</h2>
      </header>

      <ul class="about-page__milestones">
        {
          profile.milestones.map((milestone) => (
            <li>
              <h3>{milestone.label}</h3>
              <p>{milestone.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-page__values" aria-label={copy.contribution}>
      <article>
        <p class="eyebrow">{copy.contribution}</p>
        <p>{profile.contribution}</p>
      </article>
      <article>
        <p class="eyebrow">{copy.seeking}</p>
        <p>{profile.seeking}</p>
      </article>
    </section>

    <section class="about-page__next" aria-labelledby="about-next-title">
      <p class="eyebrow">{sharedCopy.aboutEyebrow}</p>
      <h2 id="about-next-title">{copy.continue}</h2>
      <div class="about-page__actions">
        <ButtonLink href={projectsUrl}>{copy.projectsAction}</ButtonLink>
        <ButtonLink href={cvUrl} variant="secondary">{copy.cvAction}</ButtonLink>
        <ButtonLink href={contactUrl} variant="secondary">
          {copy.contactAction}
        </ButtonLink>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-page {
    width: min(100%, var(--layout-shell-width));
    margin-inline: auto;
    padding-inline: var(--page-padding);
  }

  .about-page__hero {
    min-height: calc(100svh - var(--header-height));
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 6.5rem);
  }

  .about-page__portrait {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border-radius: 1.5rem 1.5rem 0.5rem 0.5rem;
    background: var(--color-brand-soft);
  }

  .about-page__portrait img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .about-page__intro {
    min-width: 0;
  }

  .about-page__location {
    margin: 0 0 0.7rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 720;
  }

  .about-page__intro h1 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(3.3rem, 6.7vw, 6.8rem);
    font-weight: 780;
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .about-page__role {
    margin: 1.25rem 0 0;
    color: var(--color-accent-ink);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 760;
  }

  .about-page__lead {
    max-width: 43ch;
    margin: clamp(1.5rem, 3vw, 2.4rem) 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .about-page__focus {
    max-width: 45ch;
    display: grid;
    grid-template-columns: minmax(70px, auto) 1fr;
    gap: 1rem;
    margin-top: clamp(1.8rem, 3vw, 2.6rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .about-page__focus p {
    margin: 0;
    color: var(--color-brand-hover);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .about-page__focus span {
    color: var(--color-text);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .about-page__journey {
    display: grid;
    grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(2rem, 6vw, 7rem);
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--color-border);
  }

  .about-page__journey header {
    align-self: start;
  }

  .about-page__journey h2,
  .about-page__next h2 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(2.4rem, 4.5vw, 4.8rem);
    font-weight: 760;
    letter-spacing: -0.055em;
  }

  .about-page__milestones {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .about-page__milestones li {
    display: grid;
    grid-template-columns: minmax(130px, 0.45fr) minmax(0, 1.55fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .about-page__milestones h3 {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 780;
  }

  .about-page__milestones p {
    max-width: 45ch;
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .about-page__values {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--color-border);
  }

  .about-page__values article {
    min-width: 0;
    padding: clamp(2rem, 5vw, 4.5rem);
  }

  .about-page__values article:first-child {
    padding-left: 0;
  }

  .about-page__values article + article {
    border-left: 1px solid var(--color-border);
  }

  .about-page__values article > p:last-child {
    max-width: 42ch;
    margin: 0;
    font-size: clamp(1.2rem, 2.1vw, 1.8rem);
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.025em;
  }

  .about-page__next {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .about-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .about-page__hero {
      min-height: 0;
      grid-template-columns: minmax(230px, 0.8fr) minmax(0, 1.2fr);
      gap: 2.5rem;
      padding-block: 3.5rem;
    }

    .about-page__intro h1 {
      font-size: clamp(3rem, 8vw, 4.8rem);
    }

    .about-page__journey {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 700px) {
    .about-page__hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 2.5rem 4rem;
    }

    .about-page__portrait {
      order: 2;
    }

    .about-page__intro {
      order: 1;
    }

    .about-page__intro h1 {
      max-width: 9ch;
      font-size: clamp(3rem, 15vw, 4.6rem);
    }

    .about-page__focus {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .about-page__milestones li {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .about-page__values {
      grid-template-columns: 1fr;
    }

    .about-page__values article {
      padding: 2rem 0;
    }

    .about-page__values article + article {
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }

    .about-page__actions {
      align-items: stretch;
    }

    .about-page__actions :global(.button-link) {
      flex: 1 1 145px;
    }
  }
</style>
