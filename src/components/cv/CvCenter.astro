---
import { cvCenterCopy } from '../../i18n/cv-center-copy';
import {
  getCvDocumentPath,
  type CvDocumentVariant,
  type Locale,
} from '../../i18n/locale';
import { withBase } from '../../utils/paths';

interface Props {
  locale: Locale;
}

interface Option {
  locale: Locale;
  variant: CvDocumentVariant;
  label: string;
  description: string;
}

const { locale } = Astro.props;
const copy = cvCenterCopy[locale];

const designedOptions: Option[] = [
  {
    locale: 'es',
    variant: 'designed',
    ...copy.designedEs,
  },
  {
    locale: 'en',
    variant: 'designed',
    ...copy.designedEn,
  },
];

const atsOptions: Option[] = [
  {
    locale: 'es',
    variant: 'ats',
    ...copy.atsEs,
  },
  {
    locale: 'en',
    variant: 'ats',
    ...copy.atsEn,
  },
];

const groups = [
  {
    id: 'designed',
    title: copy.designedGroup,
    meta: copy.designedMeta,
    options: designedOptions,
  },
  {
    id: 'ats',
    title: copy.atsGroup,
    meta: copy.atsMeta,
    options: atsOptions,
  },
];
---

<main id="contenido" class="cv-center" data-cv-center>
  <div class="cv-center__inner">
    <header class="cv-center__intro">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p>{copy.intro}</p>
    </header>

    <div class="cv-center__groups">
      {
        groups.map((group) => (
          <section
            class="cv-center__group"
            aria-labelledby={'cv-center-' + group.id}
          >
            <div class="cv-center__group-head">
              <h2 id={'cv-center-' + group.id}>{group.title}</h2>
              <span>{group.meta}</span>
            </div>

            <div class="cv-center__options">
              {group.options.map((option) => (
                <a
                  class="cv-center__option"
                  href={withBase(
                    getCvDocumentPath(option.locale, option.variant),
                  )}
                  hreflang={
                    option.locale !== locale ? option.locale : undefined
                  }
                  aria-label={copy.optionAria(option.label)}
                  data-cv-option
                  data-cv-variant={option.variant}
                  data-cv-locale={option.locale}
                >
                  <span class="cv-center__language" aria-hidden="true">
                    {option.locale.toUpperCase()}
                  </span>
                  <span class="cv-center__option-copy">
                    <strong>{option.label}</strong>
                    <span>{option.description}</span>
                  </span>
                  <span class="cv-center__arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</main>

<style>
  .cv-center {
    min-height: calc(100vh - var(--header-height));
  }

  .cv-center__inner {
    width: min(100%, 860px);
    margin-inline: auto;
    padding: clamp(4.5rem, 8vw, 7.5rem) var(--page-padding)
      clamp(5rem, 9vw, 8rem);
  }

  .cv-center__intro {
    padding-bottom: clamp(2.4rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .cv-center__intro .eyebrow {
    margin-bottom: 0.65rem;
    font-size: 0.72rem;
    font-weight: 760;
    letter-spacing: 0.16em;
  }

  .cv-center__intro h1 {
    max-width: 12ch;
    margin-bottom: 0.9rem;
    font-size: clamp(2.45rem, 6vw, 4.7rem);
    font-weight: 780;
    letter-spacing: -0.055em;
  }

  .cv-center__intro > p:last-child {
    max-width: 58ch;
    margin-bottom: 0;
    color: var(--color-text-muted);
    font-size: clamp(0.98rem, 1.6vw, 1.08rem);
  }

  .cv-center__groups {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.25rem);
    padding-top: clamp(2.25rem, 4vw, 3.25rem);
  }

  .cv-center__group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .cv-center__group-head h2,
  .cv-center__group-head span {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cv-center__group-head span {
    text-align: right;
    white-space: nowrap;
  }

  .cv-center__options {
    border-top: 1px solid var(--color-border);
  }

  .cv-center__option {
    min-height: 84px;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    gap: clamp(0.9rem, 2vw, 1.25rem);
    align-items: center;
    padding: 1rem 0.2rem;
    border-bottom: 1px solid var(--color-border);
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .cv-center__option:hover {
    background: color-mix(in srgb, var(--color-surface) 58%, transparent);
    transform: translateX(3px);
  }

  .cv-center__language {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid
      color-mix(in srgb, var(--color-border) 88%, var(--color-brand));
    border-radius: 0.85rem;
    background: color-mix(
      in srgb,
      var(--color-brand-soft) 62%,
      var(--color-surface)
    );
    color: var(--color-brand-hover);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .cv-center__option-copy {
    min-width: 0;
    display: grid;
    gap: 0.18rem;
  }

  .cv-center__option-copy strong {
    color: var(--color-text);
    font-size: clamp(0.98rem, 1.8vw, 1.08rem);
    font-weight: 760;
    line-height: 1.3;
  }

  .cv-center__option-copy > span {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .cv-center__arrow {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    font-size: 1rem;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .cv-center__option:hover .cv-center__arrow,
  .cv-center__option:focus-visible .cv-center__arrow {
    color: var(--color-accent-hover);
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .cv-center__inner {
      padding-top: 3.25rem;
    }

    .cv-center__intro h1 {
      max-width: 10ch;
    }

    .cv-center__group-head {
      align-items: flex-end;
    }

    .cv-center__group-head span {
      max-width: 16ch;
      white-space: normal;
    }

    .cv-center__option {
      min-height: 92px;
      grid-template-columns: 46px minmax(0, 1fr) 30px;
      gap: 0.8rem;
      padding-block: 0.9rem;
    }

    .cv-center__language {
      width: 42px;
      height: 42px;
      border-radius: 0.75rem;
    }

    .cv-center__option-copy > span {
      font-size: 0.82rem;
    }

    .cv-center__arrow {
      width: 30px;
      height: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-center__option,
    .cv-center__arrow {
      transition: none;
    }

    .cv-center__option:hover,
    .cv-center__option:hover .cv-center__arrow,
    .cv-center__option:focus-visible .cv-center__arrow {
      transform: none;
    }
  }
</style>
