---
import { getProfessionalData } from '../../data/localized';
import type { Project } from '../../data/types';
import { homeCopy } from '../../i18n/copy';
import { getLocalizedRoutePath, type Locale } from '../../i18n/locale';
import { withBase } from '../../utils/paths';
import ProjectPreview from '../projects/ProjectPreview.astro';

interface Props {
  projects: Project[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const { profile } = getProfessionalData(locale);
const copy = homeCopy[locale];
const projectsUrl = withBase(getLocalizedRoutePath(locale, 'projects'));
const [firstName, ...lastNames] = profile.fullName.split(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid">
    <figure class="hero__portrait" data-reveal>
      <picture>
        <source
          media="(max-width: 720px)"
          srcset={withBase(profile.profileImageMobile)}
        />
        <img
          src={withBase(profile.profileImage)}
          alt={profile.profileImageAlt}
          width="1800"
          height="1200"
          fetchpriority="high"
        />
      </picture>
    </figure>

    <div class="hero__intro">
      <h1 id="hero-title" data-hero-enter>
        <span>{firstName}</span>
        <span>{lastNames.join(' ')}</span>
      </h1>
      <p class="hero__description" data-hero-enter>{profile.heroDescription}</p>
      {
        profile.availability && (
          <p class="availability" data-hero-enter>
            <span aria-hidden="true" />
            {profile.availability}
          </p>
        )
      }
      <div class="hero__actions" data-hero-enter>
        <button
          type="button"
          class="button-link button-link--primary"
          data-dialog-open="about-dialog"
        >
          {copy.viewProfile}
          <svg viewBox="0 0 20 20" aria-hidden="true"
            ><path d="M4 10h11m-4-4 4 4-4 4"></path></svg
          >
        </button>
        <button
          type="button"
          class="button-link button-link--secondary"
          data-dialog-open="contact-dialog"
        >
          {copy.contact}
          <svg viewBox="0 0 20 20" aria-hidden="true"
            ><path d="M4 10h11m-4-4 4 4-4 4"></path></svg
          >
        </button>
      </div>
    </div>

    <div class="hero__projects" aria-labelledby="featured-projects-title">
      <div class="hero__projects-head">
        <h2 id="featured-projects-title">{copy.projects}</h2>
        <a
          class="hero__projects-link"
          href={projectsUrl}
          aria-label={copy.viewAllProjects}
        >
          {copy.viewAll}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="project-preview-list">
        {projects.map((project) => <ProjectPreview {project} {locale} />)}
      </div>
    </div>
  </div>
</section>

<style>
  :global(.home-page) .hero__grid {
    width: min(100%, calc(var(--max-width) + (var(--page-padding) * 2)));
  }

  .hero__projects-link > span {
    display: inline-block;
    transition: transform 180ms ease;
  }

  .hero__projects-link:hover > span,
  .hero__projects-link:focus-visible > span {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    :global(.home-page .project-preview__body > span) {
      overflow: visible;
      line-height: 1.35;
      text-overflow: clip;
      white-space: normal;
    }
  }

  @media (max-width: 720px) {
    :global(.home-page) .hero__intro {
      order: 1;
    }

    :global(.home-page) .hero__portrait {
      order: 2;
    }

    :global(.home-page) .hero__projects {
      order: 3;
    }

    :global(.home-page) .hero__actions .button-link {
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__projects-link > span {
      transition: none;
    }

    .hero__projects-link:hover > span,
    .hero__projects-link:focus-visible > span {
      transform: none;
    }
  }
</style>
