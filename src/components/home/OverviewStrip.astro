---
import { education } from '../../data/es/education';
import { experience } from '../../data/es/experience';
import { technologyGroups } from '../../data/es/technologies';
import { technologyIcons } from '../../data/technology-icons';
import { withBase } from '../../utils/paths';
---

<section class="home-overview" aria-label="Professional overview">
  <div class="home-overview__inner">
    <section
      class="home-overview__technologies"
      id="tecnologias"
      aria-labelledby="overview-technologies-title"
    >
      <p class="overview-label" id="overview-technologies-title">Technologies</p>
      <div class="technology-groups">
        {
          technologyGroups.map((group) => (
            <div class="technology-group">
              <p class="technology-group__label">{group.label}</p>
              <ul>
                {group.technologies.map((technology) => {
                  const icon =
                    technologyIcons[technology as keyof typeof technologyIcons];

                  return (
                    <li>
                      {icon && (
                        <img
                          src={withBase(icon)}
                          alt=""
                          width="16"
                          height="16"
                          aria-hidden="true"
                        />
                      )}
                      <span>{technology}</span>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <article class="home-overview__fact">
      <p class="overview-label">Education</p>
      <div class="home-overview__fact-list">
        {
          education.map((item) => (
            <div class="overview-organization">
              <span class="project-preview__mark">
                {item.logo && (
                  <img
                    src={withBase(item.logo)}
                    alt={item.logoAlt}
                    width="46"
                    height="46"
                  />
                )}
              </span>
              <div>
                <h2>{item.shortTitle ?? item.title}</h2>
                <p>{item.institution}</p>
                <small>{item.period}</small>
              </div>
            </div>
          ))
        }
      </div>
    </article>

    <article class="home-overview__fact">
      <p class="overview-label">Experience</p>
      <div class="home-overview__fact-list">
        {
          experience.map((item) => (
            <div class="overview-organization">
              <span class="project-preview__mark">
                {item.logo && (
                  <img
                    src={withBase(item.logo)}
                    alt=""
                    width="46"
                    height="46"
                    aria-hidden="true"
                  />
                )}
              </span>
              <div>
                <h2>{item.role}</h2>
                <p>
                  {item.company}
                  {item.context && ` · ${item.context}`}
                </p>
                <small>{item.period}</small>
              </div>
            </div>
          ))
        }
      </div>
    </article>
  </div>
</section>

<style>
  .overview-organization {
    grid-template-columns: 64px minmax(0, 1fr);
  }

  @media (min-width: 901px) {
    .home-overview__fact-list {
      gap: 0.6rem;
    }
  }

  @media (max-width: 900px) {
    .overview-organization {
      grid-template-columns: 44px minmax(0, 1fr);
    }
  }
</style>
