---
import { getProfessionalData } from '../../data/localized';
import { technologyIcons } from '../../data/technology-icons';
import { homeCopy } from '../../i18n/copy';
import type { Locale } from '../../i18n/locale';
import { withBase } from '../../utils/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { education, experience, technologyGroups } = getProfessionalData(locale);
const copy = homeCopy[locale];
---

<section class="home-overview" aria-label={copy.professionalOverview}>
  <div class="home-overview__inner">
    <section
      class="home-overview__technologies"
      id="tecnologias"
      aria-labelledby="overview-technologies-title"
    >
      <p class="overview-label" id="overview-technologies-title">
        {copy.technologies}
      </p>
      <div class="technology-groups">
        {
          technologyGroups.map((group) => (
            <div class="technology-group">
              <p class="technology-group__label">{group.label}</p>
              <ul>
                {group.technologies.map((technology) => {
                  const icon =
                    technologyIcons[technology as keyof typeof technologyIcons];

                  return (
                    <li>
                      {icon && (
                        <img
                          src={withBase(icon)}
                          alt=""
                          width="16"
                          height="16"
                          aria-hidden="true"
                        />
                      )}
                      <span>{technology}</span>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <article class="home-overview__fact">
      <p class="overview-label">{copy.education}</p>
      <div class="home-overview__fact-list">
        {
          education.map((item) => (
            <div class="overview-organization">
              <span class="project-preview__mark">
                {item.logo && (
                  <img
                    src={withBase(item.logo)}
                    alt={item.logoAlt}
                    width="46"
                    height="46"
                  />
                )}
              </span>
              <div>
                <h2>{item.shortTitle ?? item.title}</h2>
                <p>{item.institution}</p>
                <small>{item.period}</small>
              </div>
            </div>
          ))
        }
      </div>
    </article>

    <article class="home-overview__fact">
      <p class="overview-label">{copy.experience}</p>
      <div class="home-overview__fact-list">
        {
          experience.map((item) => (
            <div class="overview-organization">
              <span class="project-preview__mark">
                {item.logo && (
                  <img
                    src={withBase(item.logo)}
                    alt=""
                    width="46"
                    height="46"
                    aria-hidden="true"
                  />
                )}
              </span>
              <div>
                <h2>{item.role}</h2>
                <p>
                  {item.company}
                  {item.context && ` · ${item.context}`}
                </p>
                <small>{item.period}</small>
              </div>
            </div>
          ))
        }
      </div>
    </article>
  </div>
</section>

<style>
  .home-overview__inner {
    --overview-item-heading-size: 0.86rem;
    --overview-item-heading-line-height: 1.25;
    width: min(100%, calc(var(--max-width) + (var(--page-padding) * 2)));
  }

  .technology-group__label,
  .home-overview__fact h2 {
    font-size: var(--overview-item-heading-size);
    line-height: var(--overview-item-heading-line-height);
  }

  .technology-group__label {
    margin-bottom: 0.45rem;
    font-weight: 760;
    letter-spacing: 0.015em;
  }

  .home-overview__fact h2 {
    font-weight: 760;
    letter-spacing: -0.01em;
  }

  .technology-groups {
    row-gap: 1.05rem;
  }

  .overview-organization {
    grid-template-columns: 64px minmax(0, 1fr);
  }

  @media (min-width: 901px) {
    .home-overview__inner {
      padding-block: 1rem;
    }

    .home-overview__fact-list {
      gap: 0.6rem;
    }
  }

  @media (max-width: 900px) {
    .overview-organization {
      grid-template-columns: 44px minmax(0, 1fr);
    }
  }
</style>
