---
import { shellCopy } from '../../i18n/copy';
import type { Locale } from '../../i18n/locale';
import { withBase } from '../../utils/paths';

interface Props {
  locale: Locale;
  variant?: 'desktop' | 'mobile';
}

const { locale, variant = 'desktop' } = Astro.props;
const copy = shellCopy[locale];
const targetLocale: Locale = locale === 'es' ? 'en' : 'es';
const targetUrl = targetLocale === 'en' ? withBase('en/') : withBase();
const targetLabel =
  targetLocale === 'en' ? copy.switchToEnglish : copy.switchToSpanish;
---

<div
  class:list={['language-switcher', `language-switcher--${variant}`]}
  role="group"
  aria-label={copy.languageSwitcher}
  data-language-switcher
>
  <a
    href={targetUrl}
    lang={targetLocale}
    hreflang={targetLocale}
    aria-label={targetLabel}
    data-locale-link={targetLocale}
  >
    {targetLocale.toUpperCase()}
  </a>
</div>

<style>
  .language-switcher {
    display: inline-flex;
    align-items: center;
  }

  .language-switcher--desktop a {
    position: relative;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.68rem 0;
    color: var(--color-text-muted);
    font-size: 0.91rem;
    font-weight: 650;
  }

  .language-switcher--desktop a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.45rem;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 200ms ease;
  }

  .language-switcher--desktop a:hover {
    color: var(--color-text);
  }

  .language-switcher--desktop a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .language-switcher--mobile {
    width: fit-content;
    margin-top: 1.5rem;
  }

  .language-switcher--mobile a {
    position: relative;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .language-switcher--mobile a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.35rem;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 200ms ease;
  }

  .language-switcher--mobile a:hover {
    color: var(--color-text);
  }

  .language-switcher--mobile a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
