---
import { shellCopy } from '../../i18n/copy';
import type { Locale } from '../../i18n/locale';
import { withBase } from '../../utils/paths';

interface Props {
  locale: Locale;
  variant?: 'desktop' | 'mobile';
}

const { locale, variant = 'desktop' } = Astro.props;
const copy = shellCopy[locale];
const spanishUrl = withBase();
const englishUrl = withBase('en/');
---

<div
  class:list={['language-switcher', `language-switcher--${variant}`]}
  role="group"
  aria-label={copy.languageSwitcher}
  data-language-switcher
>
  {
    locale === 'es' ? (
      <span
        lang="es"
        aria-current="true"
        aria-label={`${copy.spanish}, ${copy.currentLanguage}`}
      >
        ES
      </span>
    ) : (
      <a
        href={spanishUrl}
        lang="es"
        hreflang="es"
        aria-label={copy.spanish}
        data-locale-link="es"
      >
        ES
      </a>
    )
  }
  {
    locale === 'en' ? (
      <span
        lang="en"
        aria-current="true"
        aria-label={`${copy.english}, ${copy.currentLanguage}`}
      >
        EN
      </span>
    ) : (
      <a
        href={englishUrl}
        lang="en"
        hreflang="en"
        aria-label={copy.english}
        data-locale-link="en"
      >
        EN
      </a>
    )
  }
</div>

<style>
  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
  }

  .language-switcher--desktop a,
  .language-switcher--desktop span {
    position: relative;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.68rem 0;
    color: var(--color-text-muted);
    font-size: 0.91rem;
    font-weight: 650;
  }

  .language-switcher--desktop a::after,
  .language-switcher--desktop span::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.45rem;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 200ms ease;
  }

  .language-switcher--desktop a:hover,
  .language-switcher--desktop span[aria-current='true'] {
    color: var(--color-text);
  }

  .language-switcher--desktop a:hover::after,
  .language-switcher--desktop span[aria-current='true']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .language-switcher--mobile {
    width: fit-content;
    margin-top: 1.5rem;
    gap: 1rem;
  }

  .language-switcher--mobile a,
  .language-switcher--mobile span {
    position: relative;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .language-switcher--mobile a::after,
  .language-switcher--mobile span::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.35rem;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 200ms ease;
  }

  .language-switcher--mobile a:hover,
  .language-switcher--mobile span[aria-current='true'] {
    color: var(--color-text);
  }

  .language-switcher--mobile a:hover::after,
  .language-switcher--mobile span[aria-current='true']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
