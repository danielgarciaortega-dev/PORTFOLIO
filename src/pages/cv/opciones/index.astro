---
import AboutDialog from '../../../components/dialogs/AboutDialog.astro';
import { getCvDocumentPath } from '../../../i18n/locale';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../utils/paths';

const designedEs = withBase(getCvDocumentPath('es', 'designed'));
const designedEn = withBase(getCvDocumentPath('en', 'designed'));
const atsEs = withBase(getCvDocumentPath('es', 'ats'));
const atsEn = withBase(getCvDocumentPath('en', 'ats'));
---

<BaseLayout
  title="Currículum · Daniel García Ortega"
  description="Elige entre el currículum con diseño o la versión ATS de Daniel García Ortega, en español o inglés."
  currentPage="cvCenter"
  localizedRoute="cvCenter"
>
  <main id="contenido" class="cv-center-page" data-cv-center>
    <section class="section-shell" aria-labelledby="cv-center-title">
      <p class="eyebrow">CURRÍCULUM</p>
      <h1 id="cv-center-title">Elige formato e idioma</h1>
      <p>
        Las cuatro rutas forman parte del mismo currículum y conservan la misma
        información profesional.
      </p>

      <section aria-labelledby="cv-designed-title">
        <h2 id="cv-designed-title">Con diseño</h2>
        <ul>
          <li>
            <a
              href={designedEs}
              data-cv-option
              data-cv-variant="designed"
              data-cv-locale="es"
            >
              Currículum · Español
            </a>
          </li>
          <li>
            <a
              href={designedEn}
              hreflang="en"
              data-cv-option
              data-cv-variant="designed"
              data-cv-locale="en"
            >
              Résumé · English
            </a>
          </li>
        </ul>
      </section>

      <section aria-labelledby="cv-ats-title">
        <h2 id="cv-ats-title">Formato ATS</h2>
        <ul>
          <li>
            <a
              href={atsEs}
              data-cv-option
              data-cv-variant="ats"
              data-cv-locale="es"
            >
              Currículum ATS · Español
            </a>
          </li>
          <li>
            <a
              href={atsEn}
              hreflang="en"
              data-cv-option
              data-cv-variant="ats"
              data-cv-locale="en"
            >
              ATS résumé · English
            </a>
          </li>
        </ul>
      </section>
    </section>
  </main>
  <AboutDialog />
</BaseLayout>
