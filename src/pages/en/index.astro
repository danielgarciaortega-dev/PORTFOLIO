---
import AboutDialog from '../../components/dialogs/AboutDialog.astro';
import ContactDialog from '../../components/dialogs/ContactDialog.astro';
import Hero from '../../components/home/Hero.astro';
import OverviewStrip from '../../components/home/OverviewStrip.astro';
import ProjectDialog from '../../components/projects/ProjectDialog.astro';
import { getProjects } from '../../data/projects-localized';
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'en';
const projects = getProjects(locale);
---

<BaseLayout
  title="Daniel García Ortega · Full-stack web developer"
  description="Portfolio of Daniel García Ortega, full-stack web developer in Granada: projects, technologies, experience, education and CV."
  currentPage="home"
  localizedRoute="home"
>
  <main id="contenido" class="home-page">
    <Hero projects={projects.filter((project) => project.featured)} {locale} />
    <OverviewStrip {locale} />
  </main>
  <AboutDialog />
  <ContactDialog />
  {
    projects.map((project, index) => (
      <ProjectDialog
        {project}
        nextProject={projects[(index + 1) % projects.length]}
        {locale}
      />
    ))
  }
</BaseLayout>
