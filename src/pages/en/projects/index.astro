---
import ProjectDialog from '../../../components/projects/ProjectDialog.astro';
import ProjectGrid from '../../../components/projects/ProjectGrid.astro';
import {
  PROJECT_BACKDROP_DURATION_SECONDS,
  PROJECT_BACKDROP_INITIAL_OFFSET_SECONDS,
  PROJECT_BACKDROP_STEP_SECONDS,
  projectMoments,
} from '../../../data/project-moments';
import { getProjects } from '../../../data/projects-localized';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../utils/paths';

const locale = 'en';
const projects = getProjects(locale);
---

<BaseLayout
  title="Projects · Daniel García Ortega"
  description="Selected projects by Daniel García Ortega: AL-LÍO, SIDN Cost Control and Feedback2Action."
  currentPage="projects"
  localizedRoute="projects"
>
  <main id="contenido" class="projects-page">
    <div class="projects-page__backdrop" aria-hidden="true">
      <div class="projects-page__moments">
        {
        projectMoments.map((moment, index) => (
          <img
            class="projects-page__moment"
            src={withBase(`images/moments/moment-${moment.number}.webp`)}
            alt=""
            style={`--moment-delay: ${
              PROJECT_BACKDROP_INITIAL_OFFSET_SECONDS +
              index * PROJECT_BACKDROP_STEP_SECONDS
            }s; --moment-duration: ${PROJECT_BACKDROP_DURATION_SECONDS}s; --moment-position-desktop: ${moment.desktopPosition}; --moment-position-mobile: ${moment.mobilePosition};`}
            loading={moment.loading}
            fetchpriority={moment.fetchPriority}
            decoding="async"
          />
        ))
      }
      </div>
      <div class="projects-page__contexts">
        {
          projects.map(
            (project) =>
              project.image && (
                <img
                  class="projects-page__context-image"
                  src={withBase(project.image)}
                  alt=""
                  data-project-context-image={project.id}
                  loading="eager"
                  fetchpriority="low"
                  decoding="async"
                />
              ),
          )
        }
      </div>
    </div>
    <section
      class="section-shell projects-page-list projects-page-list--solo"
      aria-label="Project list"
    >
      <h1 class="sr-only">Projects</h1>
      <ProjectGrid {projects} {locale} />
    </section>
  </main>
  {
    projects.map((project, index) => (
      <ProjectDialog
        {project}
        nextProject={projects[(index + 1) % projects.length]}
        {locale}
      />
    ))
  }
</BaseLayout>

<script>
  import '../../../scripts/project-context-backdrop';
</script>
