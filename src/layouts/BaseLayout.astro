---
import Header from '../components/layout/Header.astro';
import { shellCopy } from '../i18n/copy';
import {
  SUPPORTED_LOCALES,
  getLocalizedRouteUrl,
  resolveLocaleFromPathname,
  type Locale,
  type LocalizedRoute,
} from '../i18n/locale';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentPage: 'home' | 'projects' | '404';
  localizedRoute?: LocalizedRoute;
  robots?: string;
}

const {
  title,
  description,
  currentPage,
  localizedRoute,
  robots = 'index, follow',
} = Astro.props;
const locale = resolveLocaleFromPathname(
  Astro.url.pathname,
  import.meta.env.BASE_URL,
);
const copy = shellCopy[locale];
const site = Astro.site ?? Astro.url.origin;
const canonical = localizedRoute
  ? getLocalizedRouteUrl(site, import.meta.env.BASE_URL, locale, localizedRoute)
  : new URL(Astro.url.pathname, site);
const alternates = localizedRoute
  ? SUPPORTED_LOCALES.map((alternateLocale) => ({
      locale: alternateLocale,
      href: getLocalizedRouteUrl(
        site,
        import.meta.env.BASE_URL,
        alternateLocale,
        localizedRoute,
      ),
    }))
  : [];
const ogImage = new URL(withBase('og-image.webp'), site);
const openGraphLocales: Record<Locale, string> = {
  es: 'es_ES',
  en: 'en_GB',
};
const socialImageAlt: Record<Locale, string> = {
  es: 'Daniel García Ortega, desarrollador web full-stack',
  en: 'Daniel García Ortega, full-stack web developer',
};
const alternateLocale: Locale = locale === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map(({ locale: alternateLanguage, href }) => (
        <link rel="alternate" hreflang={alternateLanguage} href={href} />
      ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {
      localizedRoute && (
        <meta
          property="og:locale:alternate"
          content={openGraphLocales[alternateLocale]}
        />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={socialImageAlt[locale]} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{copy.skipLink}</a>
    <Header currentPage={currentPage} {locale} />
    <slot />
    <script>
      import '../scripts/mobile-menu';
      import '../scripts/dialogs';
      import '../scripts/clipboard';
      import '../scripts/reveal';
      import '../scripts/locale-switcher';
    </script>
  </body>
</html>
