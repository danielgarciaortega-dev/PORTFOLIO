---
import Header from '../components/layout/Header.astro';
import { shellCopy } from '../i18n/copy';
import { resolveLocaleFromPathname } from '../i18n/locale';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentPage: 'home' | 'projects' | '404';
  robots?: string;
}

const {
  title,
  description,
  currentPage,
  robots = 'index, follow',
} = Astro.props;
const locale = resolveLocaleFromPathname(
  Astro.url.pathname,
  import.meta.env.BASE_URL,
);
const copy = shellCopy[locale];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('og-image.webp'), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Daniel García Ortega, desarrollador web full-stack"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{copy.skipLink}</a>
    <Header currentPage={currentPage} {locale} />
    <slot />
    <script>
      import '../scripts/mobile-menu';
      import '../scripts/dialogs';
      import '../scripts/clipboard';
      import '../scripts/reveal';
      import '../scripts/locale-switcher';
    </script>
  </body>
</html>
